// TestLoom Scenario & Step Models

model TestScenario {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String         @db.Uuid
  title              String
  description        String?
  relativeRoute      String
  status             ScenarioStatus @default(DRAFT)
  requiredScenarioId String?        @db.Uuid
  tags               String[]       @default([])

  // Mandatory Audit & Soft-Delete Fields
  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String?   @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?   @db.Uuid

  // Domain Relations
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requiredScenario    TestScenario?      @relation("PrerequisiteDependency", fields: [requiredScenarioId], references: [id], onDelete: SetNull)
  dependentScenarios  TestScenario[]     @relation("PrerequisiteDependency")
  steps               TestStep[]
  workflowScenarios   WorkflowScenario[]
  executions          TestExecution[]

  @@index([projectId])
  @@index([requiredScenarioId])
  @@map("test_scenarios")
}

model TestStep {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenarioId       String     @db.Uuid
  stepOrder        Int
  actionType       ActionType
  primaryKey       String
  selectorMetadata Json       @default("{}")
  inputConfig      Json       @default("{}")
  assertionConfig  Json       @default("{}")
  description      String?
  screenshotUrl    String?

  // Mandatory Audit & Soft-Delete Fields
  createdAt DateTime  @default(now()) @db.Timestamptz
  createdBy String?   @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz
  deletedBy String?   @db.Uuid

  // Domain Relations
  scenario    TestScenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  stepResults ExecutionStepResult[]

  @@unique([scenarioId, stepOrder])
  @@index([scenarioId])
  @@map("test_steps")
}
